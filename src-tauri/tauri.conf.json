{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Arima Player",
  "version": "1.0.0",
  "identifier": "com.arima.player",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Arima Player",
        "width": 1180,
        "height": 740,
        "minWidth": 940,
        "minHeight": 600,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "center": true,
        "theme": "Dark"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "delphinelil09",
    "shortDescription": "Local music player with native DSP, FFT visualizer, and glass UI",
    "icon": [
      "icons/icon.ico",
      "icons/32x32.png",
      "icons/64x64.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png"
    ]
  }
}
